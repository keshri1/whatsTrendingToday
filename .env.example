# ── Site ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://whatstrendingtoday.com

# ── YouTube Data API v3 ───────────────────────────────────────
# console.cloud.google.com → Enable YouTube Data API v3
YOUTUBE_API_KEY=

# ── Anthropic Claude (AI summaries) ─────────────────────────
ANTHROPIC_API_KEY=sk-ant-

# ── TikTok Research API ──────────────────────────────────────
# developers.tiktok.com → Apply for Research API
TIKTOK_ACCESS_TOKEN=

# ── Instagram Graph API ──────────────────────────────────────
# developers.facebook.com → Instagram Basic Display or Graph API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ── Twitter/X Bearer Token ───────────────────────────────────
# developer.x.com → Create app → Bearer Token
TWITTER_BEARER_TOKEN=

# ── Google SEO verification ──────────────────────────────────
GOOGLE_VERIFICATION=

# ── Cron secret (protect /api/cron endpoint) ─────────────────
CRON_SECRET=generate-with-openssl-rand-hex-32

# ── Redis (optional — for distributed cache on multi-instance)
# REDIS_URL=redis://localhost:6379
